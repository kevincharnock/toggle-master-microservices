# ============================================================================
# TEMPLATE - NAO COMITE ESTE ARQUIVO COM VALORES REAIS
#
# Depois do terraform apply, pegue os valores:
#   terraform output postgres_endpoints
#
# E crie o secret via CLI (mais seguro que comitar YAML):
#   kubectl create secret generic auth-db-secret \
#     --from-literal=host=SEU_ENDPOINT_RDS \
#     --from-literal=port=5432 \
#     --from-literal=username=toggleadmin \
#     --from-literal=password=SUA_SENHA
#
# A senha esta no AWS Secrets Manager (criada pelo Terraform):
#   aws secretsmanager get-secret-value \
#     --secret-id toggle-master-dev/auth/postgres \
#     --query SecretString --output text
# ============================================================================

apiVersion: v1
kind: Secret
metadata:
  name: auth-db-secret
  namespace: default
type: Opaque
stringData:
  host: "toggle-master-dev-auth.XXXXXX.us-east-1.rds.amazonaws.com"
  port: "5432"
  username: "toggleadmin"
  password: "PREENCHER"
